# Visual Studio / .NET Framework build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.pdb

# NOTE: do not add "x64/" or "x86/" here (the standard VisualStudio.gitignore has them).
# GradingSystem1/SqlServerTypes/x64 and x86 hold native DLLs the project needs.

# Visual Studio cache and per-user files
.vs/
*.user
*.suo
*.rsuser
*.userosscache
*.sln.docstates

# NuGet packages (Visual Studio restores them)
packages/
*.nupkg

# Logs and temp files
*.log
*.tmp
*.cache

# Archives and real database dumps (only database/gradingsystem_demo.sql belongs in the repo)
*.zip
gradingsystemdb*.sql

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Claude Code local settings
.claude/

# Local secrets
.env
.env.*
